<Window x:Class="RandomTeamDraw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="랜덤 조 편성" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{StaticResource PageBackground}" Foreground="{StaticResource BodyText}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="14">
    <Window.InputBindings>
        <KeyBinding Key="W" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.Properties}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Properties}" Executed="WeightSettings_OnExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ParticipantCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="BorderBrush" Value="#60A5FA" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TeamParticipantTemplate">
            <Border Style="{StaticResource ParticipantCard}">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LastAssignedTemplate">
            <Border Background="#EFF6FF" BorderBrush="#60A5FA" BorderThickness="2"
                    CornerRadius="12" Padding="18,12">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="방금 배정" Foreground="#64748B" FontSize="12"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Foreground="#172033" FontSize="30"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding DisplayTeamName}" Foreground="#2563EB" FontSize="18"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" From="0.96" To="1" Duration="0:0:0.25" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" From="0.96" To="1" Duration="0:0:0.25" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="랜덤 조 편성" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Margin="0,0,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#10B981" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveStatus}" Value="저장 중">
                                    <Setter Property="Fill" Value="#F59E0B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSaveError}" Value="True">
                                    <Setter Property="Fill" Value="#EF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding SaveStatus}" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="270" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="7*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="참가자 등록" FontSize="18" FontWeight="Bold" />
                    <TextBox x:Name="NameInput" Grid.Row="1" Margin="0,14,0,7"
                             Text="{Binding NewParticipantName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30" PreviewKeyDown="NameInput_OnPreviewKeyDown"
                             ToolTip="참가자 이름을 입력하세요" />
                    <Button Grid.Row="2" Content="＋ 추가" Margin="0" HorizontalContentAlignment="Center" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddParticipantCommand}" Click="AddButton_OnClick"
                            ToolTip="입력한 참가자를 무작위 조에 배정합니다" />
                    <TextBlock Grid.Row="3" Text="{Binding ValidationMessage}" Foreground="#DC2626"
                               FontSize="12" Margin="2,5,0,0" TextWrapping="Wrap" />
                    <DockPanel Grid.Row="4" Margin="0,8,0,10">
                        <TextBlock Text="참가자 명단" FontSize="17" FontWeight="Bold" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalCount, StringFormat={}{0}명}"
                                   Foreground="{StaticResource MutedText}" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Participants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ParticipantCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DisplayTeamName}" FontSize="12" Foreground="{StaticResource MutedText}" />
                                            </StackPanel>
                                            <TextBox x:Name="EditNameBox" Grid.Column="0" Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="30">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="수정" Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="이름 수정">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NeutralButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="삭제" Command="{Binding DataContext.DeleteParticipantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="즉시 삭제">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="저장" Style="{StaticResource SuccessButton}" Command="{Binding DataContext.SaveEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="취소" Style="{StaticResource NeutralButton}" Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="조 편성 현황" FontSize="18" FontWeight="Bold" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalCount, StringFormat=총 {0}명}" HorizontalAlignment="Right" Foreground="{StaticResource MutedText}" />
                    </DockPanel>
                    <ContentControl Grid.Row="2" Content="{Binding LastAssignedParticipant}"
                                    ContentTemplate="{StaticResource LastAssignedTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="14" /><RowDefinition /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14">
                            <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Team1Name}" Foreground="#2563EB" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding Team1Count, StringFormat={}{0}명}" Foreground="{StaticResource MutedText}" Margin="0,2,0,10" /></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Team1Participants}" ItemTemplate="{StaticResource TeamParticipantTemplate}" /></ScrollViewer></DockPanel>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="14">
                            <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Team2Name}" Foreground="#059669" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding Team2Count, StringFormat={}{0}명}" Foreground="{StaticResource MutedText}" Margin="0,2,0,10" /></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Team2Participants}" ItemTemplate="{StaticResource TeamParticipantTemplate}" /></ScrollViewer></DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="0" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="10" Padding="14">
                            <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Team3Name}" Foreground="#9333EA" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding Team3Count, StringFormat={}{0}명}" Foreground="{StaticResource MutedText}" Margin="0,2,0,10" /></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Team3Participants}" ItemTemplate="{StaticResource TeamParticipantTemplate}" /></ScrollViewer></DockPanel>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="10" Padding="14">
                            <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Team4Name}" Foreground="#D97706" FontSize="18" FontWeight="Bold" /><TextBlock Text="{Binding Team4Count, StringFormat={}{0}명}" Foreground="{StaticResource MutedText}" Margin="0,2,0,10" /></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Team4Participants}" ItemTemplate="{StaticResource TeamParticipantTemplate}" /></ScrollViewer></DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="설정" Style="{StaticResource NeutralButton}"
                    Click="WeightSettingsButton_OnClick" ToolTip="조 이름과 배정 가중치를 설정합니다" />
            <Button Content="전체 초기화" Style="{StaticResource DangerButton}" Click="ResetButton_OnClick" ToolTip="모든 참가자를 삭제합니다" />
        </StackPanel>
    </Grid>
</Window>
