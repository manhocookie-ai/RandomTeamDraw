{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "status",
    "repository",
    "techStack",
    "currentMilestoneId",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "blocked",
        "completed",
        "archived"
      ]
    },
    "repository": {
      "type": "string"
    },
    "techStack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currentMilestoneId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    }
  }
}
